Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  readability-identifier-naming,
  readability-inconsistent-declaration-parameter-name,
  readability-magic-numbers,
  misc-*
WarningsAsErrors: ''
HeaderFilterRegex: '.*(软件/Project/MDK|软件/Libraries).*'
AnalyzeTemporaryDtors: false
FormatStyle: none
